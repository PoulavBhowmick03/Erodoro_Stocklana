{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:accounts": "node scripts/check-accounts.mjs",
    "check:pdas": "node scripts/check-pdas.mjs",
    "prebuild": "node scripts/check-network-config.mjs && node scripts/gen-deployment-facts.mjs --check && node scripts/check-accounts.mjs && node scripts/check-oracle-decoder.mjs && node scripts/gen-error-table.mjs --check",
    "check:oracle": "node scripts/check-oracle-decoder.mjs",
    "test:tour": "node tour.spec.mjs",
    "test:tour:build": "next build && node tour.spec.mjs",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "test:ux": "pnpm test:unit && pnpm test:tour:build && pnpm test:audit && pnpm test:flows",
    "gen:errors": "node scripts/gen-error-table.mjs",
    "check:errors": "node scripts/gen-error-table.mjs --check && node scripts/check-error-decoder.mts",
    "test:audit": "node ux-audit.spec.mjs",
    "test:audit:build": "next build && node ux-audit.spec.mjs",
    "test:flows": "node flows.spec.mjs",
    "record:flows": "next build && FIXTURE_MODE=record node flows.spec.mjs",
    "gen:deployment": "node scripts/gen-deployment-facts.mjs"
  },
  "dependencies": {
    "@bonasa-tech/manifest-sdk": "0.2.44",
    "@coral-xyz/anchor": "^0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.16.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.4",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.5"
}
