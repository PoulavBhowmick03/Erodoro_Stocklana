# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# Every NEXT_PUBLIC_ value here is substituted into the JavaScript at build
# time and shipped to the browser.
# substituted into the JavaScript at build time and shipped to the browser.
# Nothing prefixed NEXT_PUBLIC_ is a secret. Verify
# for yourself after a build:
#
#   grep -ro "your-key-here" web/out/ | wc -l
#
# Set them wherever `pnpm build` runs: .env.local for a local build, and the
# Cloudflare project's build-time variables when Workers Builds does it.

# Build target. The client verifies the RPC's genesis hash before mounting any
# wallet or transaction surface. Unknown values fail the build.
NEXT_PUBLIC_NETWORK=devnet

# Devnet starts on Solana's public endpoint locally, with the secret-backed
# Cloudflare /rpc route as a retryable-failure fallback, and uses /rpc directly
# in production. Mainnet requires an explicit production endpoint.
NEXT_PUBLIC_MAINNET_RPC_URL=

# MagicBlock ephemeral rollup endpoint. Devnet has a checked default; Mainnet
# requires an explicit production endpoint.
NEXT_PUBLIC_EPHEMERAL_RPC_URL=https://devnet.magicblock.app

# Optional validator override. Leave blank for the app to verify the identity
# directly from NEXT_PUBLIC_EPHEMERAL_RPC_URL. Set this only for a pinned local
# stack or a validator whose identity is managed alongside the deployment.
NEXT_PUBLIC_ROLLUP_VALIDATOR=

# Program ID of the separately deployed GPL Manifest fork with Erodoro's
# deterministic-market and MagicBlock lifecycle instructions. Leave unset to
# keep using the built-in Apache-2.0 book. Stock Manifest is not compatible.
NEXT_PUBLIC_MANIFEST_PROGRAM_ID=
NEXT_PUBLIC_QUOTE_MINT=

# Optional per-deployment program addresses. Devnet defaults to the addresses
# carried by the checked IDLs. Mainnet prebuild requires the production series,
# factory, oracle-adapter and Manifest addresses explicitly.
NEXT_PUBLIC_SERIES_PROGRAM_ID=
NEXT_PUBLIC_FACTORY_PROGRAM_ID=
NEXT_PUBLIC_ORACLE_ADAPTER_PROGRAM_ID=
NEXT_PUBLIC_MARKET_PROGRAM_ID=
